# Supabase (client + server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_ANON_KEY=...

# Vite client vars (must be VITE_ prefixed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# AI: OpenAI through the official SDK (Responses API). The platform key every
# AI feature runs on unless a workspace saved its own key (Settings → API Keys).
# The model is fixed in code — gpt-5-nano, gpt-5-mini only for the optional
# premium page tier — so there is no model setting. The daily briefing reads its
# own copy from Supabase function secrets.
OPENAI_API_KEY=sk-...
AI_CREDIT_MARKUP=5
AI_CREDIT_VALUE_MICROS=10000

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron / internal
CRON_SECRET=some-long-random-secret-for-cron-endpoints

# Other (from code)
# Add as needed for Sharetribe sync, etc.
