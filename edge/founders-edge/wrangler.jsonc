{
  // Founders Edge — reverse proxy for connected customer domains.
  // Deploy with: npx wrangler deploy (from this directory, in the
  // founders.click Cloudflare account).
  //
  // One-time account setup (see README.md):
  //  1. A Cloudflare zone for founders.click with Cloudflare for SaaS enabled.
  //  2. proxy.founders.click as the custom-hostname fallback origin, routed to
  //     this Worker (route: proxy.founders.click/* plus a wildcard route for
  //     custom hostnames).
  //  3. Custom hostnames created per connected domain via API — the app stores
  //     the id in workspace_domains.cloudflare_hostname_id.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "founders-edge",
  "compatibility_date": "2025-09-24",
  "main": "worker.js"
}
